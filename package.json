{
  "name": "audio-player",
  "version": "1.0.0",
  "type": "module",
  "main": "src/main.js",
  "license": "Unlicense",
  "author": "Samuel Rinnetmäki <samuel@iki.fi>",
  "scripts": {
    "build": "webpack",
    "build:pwa": "webpack --config-name pwa",
    "build:tizen": "webpack --config-name tizen",
    "start": "webpack serve --config-name pwa --open",
    "test-deploy": "npm run build:pwa && scp dist/pwa/* ctrldash.app:/www/ctrldash/music/test/",
    "package:tizen": "npm run build:tizen && ${TIZEN_STUDIO:-$HOME/tizen-studio}/tools/ide/bin/tizen package -t wgt -- dist/tizen && mv 'dist/tizen/Ctrl music.wgt' dist/tizen/CtrlMusic.wgt",
    "install:tv": "${TIZEN_STUDIO:-$HOME/tizen-studio}/tools/sdb connect $TV_IP && ${TIZEN_STUDIO:-$HOME/tizen-studio}/tools/ide/bin/tizen install -n CtrlMusic.wgt -- dist/tizen"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/credential-providers": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "jsqr": "latest",
    "qrcode-generator": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@babel/preset-env": "latest",
    "babel-loader": "latest",
    "copy-webpack-plugin": "latest",
    "html-webpack-plugin": "latest",
    "terser-webpack-plugin": "latest",
    "webpack": "latest",
    "webpack-cli": "latest",
    "webpack-dev-server": "latest"
  }
}
