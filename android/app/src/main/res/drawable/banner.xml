<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher's banner, 320 × 180: the app's icon on the TV app's background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="@color/background" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp" android:drawable="@drawable/icon" />
</layer-list>
